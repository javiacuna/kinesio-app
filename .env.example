APP_NAME=kinesio-app
ENV=local
HTTP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kinesio
DB_USER=kinesio
DB_PASSWORD=kinesio
DB_SSLMODE=disable

FIREBASE_PROJECT_ID=proyecto-final-b67f5
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Si es true, habilita "Authorization: Bearer demo-recepcionista-token" como
# atajo para probar endpoints de recepcionista sin credenciales reales de
# Firebase. Dejar en false (o sin setear) en cualquier entorno con datos
# reales de pacientes.
ALLOW_DEMO_AUTH=false

# URL publica de esta app (sin barra final), ej. https://kinesio-app.onrender.com.
# Si esta seteada, los mails de reseteo/invitacion de contraseña llevan a
# nuestra propia pantalla de reseteo (/reset-password) en vez de la de Firebase.
# El dominio debe estar en Firebase Console > Authentication > Settings > Authorized domains.
PUBLIC_BASE_URL=

NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Kinesio App

# Videollamadas automáticas: usar "daily" o "whereby".
# Si VIDEO_CALL_PROVIDER queda vacío, se puede seguir pegando links manualmente.
VIDEO_CALL_PROVIDER=
DAILY_API_KEY=
WHEREBY_API_KEY=
WHEREBY_ROOM_PREFIX=kinesio
VIDEO_CALL_EXPIRY_MIN=60
